    "根据各提供方配额重置周期与节奏智能平摊请求，防止特定账号过早耗尽额度。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreads requests intelligently according to each provider's quota reset cycle so no account runs out too early."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロバイダーのクォータリセット周期に合わせてリクエストを賢く分散し、特定アカウントの早期枯渇を防ぎます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據各提供方配額重置週期與節奏智慧平攤請求，防止特定帳號過早耗盡額度。"
          }
        }
      }
    },
